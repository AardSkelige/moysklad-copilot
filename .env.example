TELEGRAM_BOT_TOKEN=
FINANCE_ADMIN_TELEGRAM_ID=
# Для нескольких пользователей указывайте ID через запятую:
# FINANCE_ADMIN_TELEGRAM_ID=123456789,987654321
TIMEZONE=Europe/Moscow

# МойСклад (заполняется при подключении интеграции)
MOYSKLAD_TOKEN=
MOYSKLAD_ORGANIZATION_HREF=
MOYSKLAD_AGENT_HREF=

# Идентификаторы сущностей МойСклад для производственного агента
# (id организации, складов и статуса ПЗ «Подготовка» из вашего аккаунта)
MOYSKLAD_ORG_ID=
MOYSKLAD_STORE_MATERIALS_ID=
MOYSKLAD_STORE_PRODUCTS_ID=
MOYSKLAD_PRODUCTION_TASK_STATE_PODGOTOVKA=

# AI агент (производство)
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Кто может вызывать команды агента. Формат: id:Имя через запятую
# Имя пойдёт в комментарий ПЗ (например "Аня. Заказ. Срочно")
PRODUCTION_USER_IDS=

# Коды товаров, снятых с производства (не предлагать в агенте), через запятую
PRODUCTION_EXCLUDED_CODES=

# Имя-префикс для комментариев операций финансового модуля (например "Катя")
FINANCE_COMMENT_AUTHOR=

# Деплой (используется deploy.sh)
DEPLOY_SERVER=

# Аудит учёта МойСклад (все переменные опциональны — есть дефолты)
# AUDIT_ENABLED=true                # выключить: false
# AUDIT_OWNER_TELEGRAM_ID=          # получатель находок; по умолчанию первый из FINANCE_ADMIN_TELEGRAM_ID
# AUDIT_INCREMENTAL_MINUTES=90      # период инкрементальных прогонов
# AUDIT_FULL_HOUR=6                 # час ночного полного скана
# AUDIT_SCAN_MONTHS=3               # глубина полного скана
# AUDIT_RETRO_EDIT_HOURS=24         # порог «правка задним числом»
# AUDIT_STALE_DRAFT_DAYS=7          # черновики складских документов
# AUDIT_STALE_ORDER_DAYS=14         # черновики заказов
# AUDIT_PRODUCTION_STUCK_DAYS=14    # ПЗ не «Готово» дольше N дней
# AUDIT_MAX_MESSAGES_PER_RUN=10     # больше находок за прогон — дайджест
